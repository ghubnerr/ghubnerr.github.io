  title={From Signals to Semantics: A Survey on Time Series Explainability through a Human-Cognitive Lens},
  author={Chen, Zhuomin and Lucchesi, Gabriel and Dong, Qingkai and Zheng, Xu and Song, Dongjin and Wen, Qinglong and Cheng, Wei and Ni, Jingchao and Luo, Dongsheng},
